{
  "variables": {
    "image_name": "ack-optimized_image-1.22-{{timestamp}}",
    "source_image": "aliyun_3_x64_20G_alibase_20230110.vhd",
    "instance_type": "ecs.c6.xlarge",
    "region": "{{env `ALICLOUD_REGION`}}",
    "access_key": "{{env `ALICLOUD_ACCESS_KEY`}}",
    "secret_key": "{{env `ALICLOUD_SECRET_KEY`}}"
  },
  "builders": [
    {
      "type": "alicloud-ecs",
      "access_key": "{{user `access_key`}}",
      "secret_key": "{{user `secret_key`}}",
      "region": "{{user `region`}}",
      "image_name": "{{user `image_name`}}",
      "source_image": "{{user `source_image`}}",
      "ssh_username": "root",
      "instance_type": "{{user `instance_type`}}",
      "skip_image_validation": "true",
      "io_optimized": "true"
    }
  ],
  "provisioners": [{
      "type": "file",
      "source": "scripts/ack-optimized-os-linux3-all.sh",
      "destination": "/root/"
    },
    {
      "type": "shell",
      "inline": [
        "export RUNTIME=containerd",
        "export RUNTIME_VERSION=1.6.20",
        "export SKIP_SECURITY_FIX=true",
        "export OS_ARCH=amd64",
        "export KUBE_VERSION=1.22.3-aliyun.1",
        "bash /root/ack-optimized-os-linux3-all.sh",
        "touch /var/.skip-yum",
        "# Add cached images here for faster bootstrapping (e.g., cluster components or business images)",
        "# Example: ctr -n k8s.io i pull registry.example.com/acs/pause:3.9"
      ]
    }]
}